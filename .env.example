APP_NAME=Summary
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

ORGANIZATION_APP_NAME="${APP_NAME}"
ORGANIZATION_NAME="LPRL Sorong"
ORGANIZATION_SHORT_NAME="LPRL Sorong"
ORGANIZATION_LOGO_PATH=
ORGANIZATION_FAVICON_PATH=
ORGANIZATION_ADDRESS=
ORGANIZATION_ORGANIZER_NAME="LPRL Sorong"
ORGANIZATION_ORGANIZER_INPUT_MODE=locked
MONEV_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
